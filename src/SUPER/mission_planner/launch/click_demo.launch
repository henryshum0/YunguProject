<launch>

        <node pkg="perfect_drone_sim" exec="perfect_drone_node" name="perfect_drone" output="log">
            <!--     1. use absolute path -->
            <!--         <param name="config_path" value="" type="string"></param> -->
            <!--     2. use file name in super_planner/config/... -->
                    <param name="config_name" value="click.yaml"></param>
        </node>

    <!--     click_demo_high_speed.launch -->

    <node pkg="super_planner" name="fsm_node" exec="fsm_node" output="screen">
<!--     1. use absolute path -->
<!--         <param name="config_path" value="" type="string"></param> -->
<!--     2. use file name in super_planner/config/... -->
        <param name="config_name" value="click_smooth_ros2.yaml"></param>
    </node>


        <node pkg="rviz2" exec="rviz2" name="top_down" args="-d $(find-pkg-share perfect_drone_sim)/rviz2/top_down.rviz" output="log"/>
        <node pkg="rviz2" exec="rviz2" name="fpv" args="-d $(find-pkg-share perfect_drone_sim)/rviz2/fpv.rviz" output="log"/>



</launch>