<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_bridge</name>
  <version>0.1.0</version>
  <description>Dual-side LiDAR data-flow glue for the Yungu sim stack: time-fielding, fusion into a base_link cloud, IMU relay, and the RViz TF bridge. Nodes moved here from utils/fastlio and utils/gz_bridges.</description>
  <maintainer email="windshape@example.com">windshape</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
