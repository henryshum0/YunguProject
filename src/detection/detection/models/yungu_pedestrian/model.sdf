<?xml version="1.0"?>
<!-- Standing pedestrian stand-in for the mock detection loop.
     Primitive geometry only, so the model spawns without any external mesh or
     texture resource. The model origin is the ground contact plane, so it is
     spawned at the ground height directly. Overall envelope 0.50 x 0.40 x 1.75 m,
     matching the target size declared in src/detection/config/targets.yaml. -->
<sdf version="1.9">
  <model name="yungu_pedestrian">
    <static>true</static>
    <link name="body">
      <visual name="legs">
        <pose>0 0 0.425 0 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.85</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.14 1</ambient>
          <diffuse>0.15 0.16 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="torso">
        <pose>0 0 1.175 0 0 0</pose>
        <geometry><box><size>0.45 0.25 0.65</size></box></geometry>
        <material>
          <ambient>0.60 0.24 0.05 1</ambient>
          <diffuse>1.00 0.42 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="head">
        <pose>0 0 1.625 0 0 0</pose>
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material>
          <ambient>0.45 0.32 0.24 1</ambient>
          <diffuse>0.85 0.66 0.52 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.875 0 0 0</pose>
        <geometry><box><size>0.50 0.40 1.75</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
